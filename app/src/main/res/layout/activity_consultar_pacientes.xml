<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salud Segura"
            android:textColor="#4267B2"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consultar pacientes"
            android:textColor="#333333"
            android:textSize="21sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etBuscarPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar por identificación o nombre"
            android:inputType="text"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBuscarPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buscar paciente"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pacientes registrados"
            android:textColor="#4267B2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvPacienteEjemplo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Juan Pérez&#10;Identificación: 123456789&#10;Edad: 25 años&#10;Teléfono: 300 123 4567&#10;Correo: juan@email.com"
            android:textColor="#444444"
            android:textSize="16sp"
            android:background="#E8EEF9"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnEditarPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar paciente"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnEliminarPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eliminar paciente"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>